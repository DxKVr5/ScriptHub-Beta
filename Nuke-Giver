local InsertService = game:GetService("InsertService")
local Players = game:GetService("Players")


local ASSET_ID = 10694662894 

if not checkcaller or checkcaller() then

		local function giveToolToPlayer(player)
		player.CharacterAdded:Connect(function(character)

			local success, assetModel = pcall(function()
				return InsertService:LoadAsset(ASSET_ID)
			end)

			if success and assetModel then

				local tool = assetModel:FindFirstChildOfClass("Tool")
				if tool then

					local backpack = player:WaitForChild("Backpack")
					local clonedTool = tool:Clone()
					clonedTool.Parent = backpack
				end

				assetModel:Destroy()
			else
				warn("Failed to load asset ID: " .. tostring(ASSET_ID))
			end
		end)
	end

		for _, player in ipairs(Players:GetPlayers()) do
			giveToolToPlayer(player)
		end

		Players.PlayerAdded:Connect(giveToolToPlayer)

end
