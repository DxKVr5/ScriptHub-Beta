-- WARNING!!: This script is only the AimBot function Please Execute the Main File!

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local camera = Workspace.CurrentCamera

if _G.AimBot == nil then
	_G.AimBot = false
end

local FOV_RADIUS = 180 
local SMOOTHING = 4 -- Higher numbers make tracking look completely natural and pass anti-cheats

local function getClosestTarget()
	local closestTarget = nil
	local shortestDistance = math.huge
	local localCharacter = localPlayer.Character
	if not localCharacter then return nil end

	local viewportSize = camera.ViewportSize
	local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Team ~= localPlayer.Team then
			local character = player.Character
			if character and character:FindFirstChild("Head") then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					local screenPos, onScreen = camera:WorldToViewportPoint(character.Head.Position)
					if onScreen then
						local targetCoord = Vector2.new(screenPos.X, screenPos.Y)
						local distance = (targetCoord - screenCenter).Magnitude
						if distance < shortestDistance and distance <= FOV_RADIUS then
							shortestDistance = distance
							closestTarget = screenPos
						end
					end
				end
			end
		end
	end
	return closestTarget
end

RunService.RenderStepped:Connect(function()
	if _G.AimBot == true then
		local targetPos = getClosestTarget()
		if targetPos and mousemoverel then
			local viewportSize = camera.ViewportSize
			local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

			-- Simulates relative pixel shifts instead of breaking the engine orientation matrix
			local deltaX = (targetPos.X - screenCenter.X) / SMOOTHING
			local deltaY = (targetPos.Y - screenCenter.Y) / SMOOTHING

			mousemoverel(deltaX, deltaY)
		end
	end
end)
