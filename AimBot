-- WARNING!!: This script is only the AimBot function Please Execute the Main File!

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local camera = Workspace.CurrentCamera

if _G.AimBot == nil then
	_G.AimBot = false
end

local function getClosestPlayerHead()
	local closestHead = nil
	local shortestDistance = math.huge

	local localCharacter = localPlayer.Character
	if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then
		return nil
	end

	local localPos = localCharacter.HumanoidRootPart.Position

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			local character = player.Character

			if character and character:FindFirstChild("Head") and character:FindFirstChild("HumanoidRootPart") then
				local humanoid = character:FindFirstChildOfClass("Humanoid")

				if humanoid and humanoid.Health > 0 then
					local targetPos = character.HumanoidRootPart.Position
					local distance = (targetPos - localPos).Magnitude

					if distance < shortestDistance then
						shortestDistance = distance
						closestHead = character.Head
					end
				end
			end
		end
	end

	return closestHead
end

-- Tracks when the toggle state switches from True to False
local lastToggleState = false

RunService.RenderStepped:Connect(function()
	local AimBot = _G.AimBot
	local localCharacter = localPlayer.Character

	if AimBot == true then
		local targetHead = getClosestPlayerHead()

		if targetHead and camera and localCharacter then
			local rootPart = localCharacter:FindFirstChild("HumanoidRootPart")
			
			if rootPart then
				-- FIX 1: Override One Tap's camera script by forcing Scriptable mode
				camera.CameraType = Enum.CameraType.Scriptable

				local camPosition = camera.CFrame.Position
				local targetPosition = targetHead.Position

				-- 1. Hard lock camera orientation directly onto the closest player's head
				camera.CFrame = CFrame.lookAt(camPosition, targetPosition)

				-- 2. Snap body rotation to mirror the camera's locked look-vector instantly
				local LookVector = camera.CFrame.LookVector
				rootPart.CFrame = CFrame.new(rootPart.CFrame.Position, rootPart.CFrame.Position + Vector3.new(LookVector.X, 0, LookVector.Z))
			end
		else
			-- If aimbot is active but no targets are near, temporarily let the user turn the camera
			camera.CameraType = Enum.CameraType.Custom
		end
	else
		-- FIX 2: The moment you turn the UI toggle off, restore standard camera control completely
		if lastToggleState == true then
			camera.CameraType = Enum.CameraType.Custom
		end
	end
	
	lastToggleState = AimBot
end)
