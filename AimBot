-- WARNING!!: This script is only the AimBot function Please Execute the Main File!

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local camera = Workspace.CurrentCamera

if _G.AimBot == nil then
	_G.AimBot = false
end

local function getClosestPlayerHead()
	local closestHead = nil
	local shortestDistance = math.huge

	local localCharacter = localPlayer.Character
	if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then
		return nil
	end

	local localPos = localCharacter.HumanoidRootPart.Position

	for _, player in ipairs(Players:GetPlayers()) do
		-- Team check handles Rivals (Knife Duels won't mind it)
		if player ~= localPlayer and player.Team ~= localPlayer.Team then
			local character = player.Character

			if character and character:FindFirstChild("Head") and character:FindFirstChild("HumanoidRootPart") then
				local humanoid = character:FindFirstChildOfClass("Humanoid")

				if humanoid and humanoid.Health > 0 then
					local targetPos = character.HumanoidRootPart.Position
					local distance = (targetPos - localPos).Magnitude

					if distance < shortestDistance then
						shortestDistance = distance
						closestHead = character.Head
					end
				end
			end
		end
	end

	return closestHead
end

-- Smoothness factor: 1 is instant snap, lower decimals (e.g., 0.2) blend with human movement
local Smoothness = 1

-- UNIVERSAL FIX: Bind directly to Roblox's Camera engine pipeline. 
-- This forcefully overrides both games' native camera scripts without lagging.
RunService:BindToRenderStep("UniversalAimLock", Enum.RenderPriority.Camera.Value + 1, function()
	if _G.AimBot == true then
		local targetHead = getClosestPlayerHead()
		local localCharacter = localPlayer.Character

		if targetHead and camera and localCharacter then
			local camCFrame = camera.CFrame
			local targetPosition = targetHead.Position
			local targetCFrame = CFrame.lookAt(camCFrame.Position, targetPosition)

			if Smoothness == 1 then
				camera.CFrame = targetCFrame
			else
				camera.CFrame = camCFrame:Lerp(targetCFrame, Smoothness)
			end
			
			-- Because both games are 1st person, updating the camera CFrame at this priority 
			-- naturally forces the character's body model to match perfectly.
		end
	end
end)
