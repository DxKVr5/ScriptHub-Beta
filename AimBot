-- WARNING!!: This script is only the AimBot function Please Execute the Main File!

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local camera = Workspace.CurrentCamera

if _G.AimBot == nil then
	_G.AimBot = false
end

-- Team Check Fix: Rivals is competitive team-based, don't snap to teammates
local function getClosestPlayerHead()
	local closestHead = nil
	local shortestDistance = math.huge

	local localCharacter = localPlayer.Character
	if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then
		return nil
	end

	local localPos = localCharacter.HumanoidRootPart.Position

	for _, player in ipairs(Players:GetPlayers()) do
		-- Make sure they aren't you AND aren't on your team
		if player ~= localPlayer and player.Team ~= localPlayer.Team then
			local character = player.Character

			if character and character:FindFirstChild("Head") and character:FindFirstChild("HumanoidRootPart") then
				local humanoid = character:FindFirstChildOfClass("Humanoid")

				if humanoid and humanoid.Health > 0 then
					local targetPos = character.HumanoidRootPart.Position
					local distance = (targetPos - localPos).Magnitude

					if distance < shortestDistance then
						shortestDistance = distance
						closestHead = character.Head
					end
				end
			end
		end
	end

	return closestHead
end

-- Smoothness factor: 1 is instant snap, lower decimals (e.g., 0.2) make it look human
local Smoothness = 1 

RunService.RenderStepped:Connect(function()
	if _G.AimBot == true then
		local targetHead = getClosestPlayerHead()
		local localCharacter = localPlayer.Character

		if targetHead and camera and localCharacter then
			local rootPart = localCharacter:FindFirstChild("HumanoidRootPart")
			
			if rootPart then
				local camCFrame = camera.CFrame
				local targetPosition = targetHead.Position

				-- Create the exact look-at orientation matrix for first-person
				local targetCFrame = CFrame.lookAt(camCFrame.Position, targetPosition)

				-- Bypasses "Scriptable" locks by interpolating (lerping) native CFrames 
				if Smoothness == 1 then
					camera.CFrame = targetCFrame
				else
					camera.CFrame = camCFrame:Lerp(targetCFrame, Smoothness)
				end
				
				-- In first person, Roblox automatically turns your HumanoidRootPart 
				-- to match the camera. No extra rootPart math is needed here!
			end
		end
	end
end)
