local function UDXZC_fake_script() -- Move.DragScript 
	local script = Instance.new('LocalScript', Move)

	-- Dragging the Move icon moves the whole Min bar
	local UserInputService = game:GetService("UserInputService")
	
	local move = script.Parent
	local min = move.Parent.Parent -- Move -> Bar -> Min
	
	local dragging = false
	local dragStart, startPos
	
	move.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = min.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			min.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	
end
coroutine.wrap(UDXZC_fake_script)()
local function CEERZR_fake_script() -- Open.Open 
	local script = Instance.new('LocalScript', Open)

	-- Open: hide the Min bar, show the Opened window
	local button = script.Parent
	local min = button.Parent
	local screenGui = script:FindFirstAncestorOfClass("ScreenGui")
	local opened = screenGui.Opened
	
	button.MouseButton1Click:Connect(function()
		if min then
			min.Visible = false
		end
		if opened then
			opened.Visible = true
		end
	end)
	
	
end
coroutine.wrap(CEERZR_fake_script)()
